{
  "manifest_version": 3,
  "name": "ADM Download Manager",
  "short_name": "ADM",
  "version": "0.4.0",
  "description": "Sends your browser's downloads to the ADM app: a fast, lightweight download manager with multi-connection speed and resume.",
  "homepage_url": "https://github.com/Axenith/ADM",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "optional_permissions": [
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:8598/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ADM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "commands": {
    "grab-links": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Grab the links and files of this page"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
